{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://achlers.app"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "local-apk": {
      "extends": "apk",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.116:3000"
      }
    },
    "preview": {
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://achlers.app"
      },
      "distribution": "internal"
    },
    "apk": {
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://achlers.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://achlers.app"
      },
      "autoIncrement": true
    }
  }
}
